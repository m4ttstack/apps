{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "tsconfig.tools.json",
    ".prettierrc",
    "bunfig.toml",
    "eslint.config.js"
  ],
  "globalPassThroughEnv": ["CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "build:binary": {
      "dependsOn": ["build"],
      "outputs": ["dist/**", "dist-bin/**", "src/server/embedded/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
