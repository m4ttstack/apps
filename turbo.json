{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "tsconfig.tools.json",
    ".prettierrc",
    "bunfig.toml",
    "eslint.config.js"
  ],
  "globalPassThroughEnv": ["CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "build:binary": {
      "dependsOn": ["build"],
      "outputs": ["dist/**", "dist-bin/**", "src/server/embedded/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "serve-check": {},
    "chat#serve-check": {
      "dependsOn": ["build"],
      "passThroughEnv": ["GATE_PORT"]
    },
    "mattstack-console#serve-check": {
      "dependsOn": ["build:binary"],
      "passThroughEnv": ["GATE_PORT"]
    },
    "boxscore#serve-check": {
      "dependsOn": ["build:binary"],
      "passThroughEnv": ["GATE_PORT"]
    },
    "@mattstack/tui-kit#browsers": {
      "cache": false
    },
    "@mattstack/tui-kit#test": {
      "dependsOn": ["^build", "browsers"]
    },
    "@mattstack/tui-kit#gates": {
      "dependsOn": ["^build"]
    }
  }
}
